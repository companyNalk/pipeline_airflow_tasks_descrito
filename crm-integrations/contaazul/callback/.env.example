# Copie para .env e preencha. NÃO comitar o .env real.

# Credenciais do app criado no Portal do Desenvolvedor ContaAzul
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=

# DEVE bater EXATAMENTE com o redirect cadastrado no portal.
CONTAAZUL_REDIRECT_URI=https://webhook.nalk.freedomai.com.br/contaazul/callback

# Scope fixo da API v2 (não mudar a menos que a doc mude)
CONTAAZUL_SCOPE=openid profile aws.cognito.signin.user.admin

# Token do Cloudflare Tunnel (Zero Trust > Networks > Tunnels > criar > copiar token)
TUNNEL_TOKEN=
